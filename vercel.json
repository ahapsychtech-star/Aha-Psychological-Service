{
  "version": 2,
  "buildCommand": "bash -lc \"echo $VERCEL_GIT_COMMIT_SHA > build-meta.txt && date -u > build-meta-date.txt\"",
  "outputDirectory": ".",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-schedule",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/upcoming-sessions",
      "schedule": "0 4 * * *"
    }
  ]
}